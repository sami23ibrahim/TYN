# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design reference (large PDFs/exports — keep out of git)
/design-reference/
/mobile-header.png

# staging area for raw Figma exports — not yet wired into any component,
# re-exportable from the Figma file. Keep the multi-MB originals out of history.
/public/new images/
/public/images/serve-plate-2.jpg
/public/images/_Q3A*.png
