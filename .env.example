# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# Resend API key (https://resend.com → API keys → sending access).
# Leave EMPTY in development: the contact form then prints both emails to the dev server
# console instead of sending, so the whole flow is testable without a verified domain.
# In production a missing key is a hard error, so a bad deploy fails loudly.
RESEND_API_KEY=

# Optional overrides. Defaults are shown; you only need these to change where mail goes.
# ENQUIRY_TO=info@tynkitchen.cz
# ENQUIRY_FROM=TÝN <info@tynkitchen.cz>
